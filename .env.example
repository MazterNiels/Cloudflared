# ============================================================
# Cloudflared - Omgevingsvariabelen
# ============================================================
# Kopieer dit bestand naar .env, naast compose.yaml.
# Vul voor iedere tunnel een unieke containernaam en token in.
# De meegeleverde compose.yaml bevat standaard één tunnel.
# Gebruik install.sh om het gewenste aantal tunnels in te stellen.
# Het script maakt compose.yaml en .env automatisch aan.
#
# Deel nooit je tunneltokens.

# ------------------------------------------------------------
# Tunnel 1
# ------------------------------------------------------------

# Kies een unieke containernaam voor deze Docker-host.
CONTAINER_NAME_1=

# Token uit Cloudflare: open je tunnel, kies Docker en kopieer
# alleen de waarde achter --token uit de installatieopdracht.
TUNNEL_TOKEN_1=